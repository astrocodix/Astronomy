# Local SQLite, resolved relative to prisma/schema.prisma.
# For PostgreSQL: postgres://... and npm run setup (automatically chooses
# prisma/postgresql/schema.prisma, with its separate migration history).
DATABASE_URL="file:./academy.db"
APP_URL="http://localhost:3000"
# Permit the explicitly labeled seed pilot. Set false for a reviewed public launch.
CONTENT_PREVIEW="true"
# Bootstrap only: choose a unique password of 12+ characters.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# OpenAI-compatible Chat Completions endpoint. Server-only secrets.
OPENAI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4.1-mini"
AI_DAILY_LIMIT="30"
AI_TIMEOUT_MS="45000"
# Optional password-reset delivery through Resend. Never expose reset tokens publicly.
RESEND_API_KEY=""
MAIL_FROM="Astroverse Academy <academy@example.com>"
# The image archive is cached and attributed; there is no live daily-image API.
# Used only by the disposable browser-test server, never a public deployment.
ACADEMY_TEST_MODE="false"
